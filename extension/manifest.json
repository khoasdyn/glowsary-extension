{
  "manifest_version": 3,
  "name": "Glowsary",
  "version": "1.0.0",
  "description": "Highlight your saved vocabulary across the web and reveal your own definitions on demand.",
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glowsary"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["public_suffix_list.dat"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["domain-utils.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
