{
  "manifest_version": 3,
  "name": "Glowsary: Build Your Vocabulary as You Read Online",
  "short_name": "Glowsary",
  "version": "1.3.0",
  "description": "Highlight your saved vocabulary across the web and reveal your own definitions on demand.",
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Glowsary"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "public_suffix_list.dat",
        "content.css",
        "switch.css",
        "assets/check.svg",
        "assets/chevron-left.svg",
        "assets/chevron-right.svg",
        "assets/pencil-02.svg",
        "assets/trash-03.svg",
        "assets/volume-max.svg",
        "assets/x-close.svg",
        "fonts/Copse/Copse-Regular.ttf",
        "fonts/Poppins/Poppins-Regular.ttf",
        "fonts/Poppins/Poppins-Medium.ttf",
        "fonts/Poppins/Poppins-SemiBold.ttf"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "tokens/color-tokens.js",
        "tokens/semantic-color-tokens.js",
        "tokens/shadow-tokens.js",
        "tokens/typography-tokens.js",
        "tokens/semantic-typography-tokens.js",
        "tokens/radius-tokens.js",
        "tokens/image-tokens.js",
        "domain-utils.js",
        "icon-button.js",
        "speech.js",
        "color-picker.js",
        "entry-form.js",
        "auto-generate.js",
        "image-field.js",
        "image-viewer.js",
        "content.js"
      ],
      "css": ["switch.css", "content.css"],
      "run_at": "document_idle"
    }
  ]
}
